{
  "name": "dsh-oneclick-desktop",
  "version": "0.3.4",
  "description": "Windows: turns DSH into a desktop app. A one-click launcher and tray controller, plus a sidebar button that splits DSH and chat.deepseek.com side by side with its own taskbar button.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "DEVELOPING.md",
    "launcher",
    "lib/desktop.ps1"
  ],
  "engines": {
    "node": ">=20"
  },
  "os": [
    "win32"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh": "^0.2.0-rc.2"
  },
  "dsh": {
    "engine": "dsh >=0.2.0-rc.2",
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "chat",
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "launcher",
    "split",
    "taskbar",
    "tray",
    "windows"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MKInori/dsh-oneclick-desktop.git"
  },
  "homepage": "https://github.com/MKInori/dsh-oneclick-desktop#readme",
  "bugs": {
    "url": "https://github.com/MKInori/dsh-oneclick-desktop/issues"
  },
  "author": "MKInori"
}
